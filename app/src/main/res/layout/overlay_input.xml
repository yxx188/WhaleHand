<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <EditText
        android:id="@+id/etOverlayInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@null"
        android:hint="告诉它要做什么…"
        android:imeOptions="actionSend"
        android:inputType="text"
        android:maxLines="2"
        android:textColor="#E6F1FF"
        android:textColorHint="#8FA3BF"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/btnOverlaySend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_send"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="发送"
        android:textColor="#04121F"
        android:textSize="13sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/btnOverlayCollapse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:padding="8dp"
        android:text="×"
        android:textColor="#8FA3BF"
        android:textSize="18sp"/>
</LinearLayout>
