<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="对话提示词"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView
        style="@style/TextAppearance.Whale.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="附加在每次对话的系统提示里，只影响聊天，不影响任务执行"/>

    <EditText
        android:id="@+id/etPrompt"
        style="@style/Widget.Whale.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_log"
        android:gravity="top|start"
        android:hint="例如：回答先给结论再解释；不确定时先反问；不要用英文"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:minLines="6"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:textColorHint="@color/text_tertiary"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSavePrompt"
        style="@style/Widget.Whale.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="保存"/>

    <TextView
        android:id="@+id/btnCancelPrompt"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_drawer_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="取消"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"/>
</LinearLayout>
