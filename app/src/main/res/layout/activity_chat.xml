<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true">

    <!-- ================= 主内容 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部栏：左菜单 / 中对话名 / 右新建 -->
        <LinearLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/appbar_height"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btnMenu"
                style="@style/Widget.Whale.IconButton"
                android:contentDescription="菜单"
                android:src="@drawable/ic_menu"
                android:tint="@color/text_primary"/>

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.Whale.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="新对话"/>

            <ImageButton
                android:id="@+id/btnNewChat"
                style="@style/Widget.Whale.IconButton"
                android:contentDescription="新对话"
                android:src="@drawable/ic_new_chat"
                android:tint="@color/text_primary"/>
        </LinearLayout>

        <!-- 消息区 -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/svMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"/>
        </androidx.core.widget.NestedScrollView>

        <!-- Composer -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/composer"
            style="@style/Widget.Whale.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <!-- 附件预览 chips -->
                <LinearLayout
                    android:id="@+id/llAttachments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone"/>

                <!-- 常驻两行文字区 -->
                <EditText
                    android:id="@+id/etInput"
                    style="@style/Widget.Whale.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="说点什么…"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="2"
                    android:minHeight="72dp"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:scrollbars="vertical"/>

                <!-- 工具行：+ / 模型·强度 / 发送 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <ImageButton
                        android:id="@+id/btnAttach"
                        style="@style/Widget.Whale.IconButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="添加附件"
                        android:padding="9dp"
                        android:src="@drawable/ic_add"
                        android:tint="@color/text_primary"/>

                    <LinearLayout
                        android:id="@+id/btnModelEffort"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_model"
                            android:tint="@color/accent"/>

                        <TextView
                            android:id="@+id/tvModelEffort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="deepseek-flash · 标准"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"/>

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="3dp"
                            android:src="@drawable/ic_expand_more"
                            android:tint="@color/text_tertiary"/>
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <ImageButton
                        android:id="@+id/btnSend"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_send_circle"
                        android:contentDescription="发送"
                        android:padding="11dp"
                        android:src="@drawable/ic_arrow_up"
                        android:tint="@color/on_accent"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ================= 左侧抽屉 ================= -->
    <LinearLayout
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <!-- 头部 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="14dp">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp">

                <View
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_dot_glow"/>

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_logo"
                    android:gravity="center"
                    android:text="🐋"
                    android:textSize="22sp"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Whale.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WhaleHand"/>

                <TextView
                    android:id="@+id/tvDrawerMeta"
                    style="@style/TextAppearance.Whale.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="deepseek-flash · 标准"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.Whale.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="6dp"
            android:text="会话"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llSessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:background="@color/stroke_soft"/>

        <LinearLayout
            android:id="@+id/btnDesk"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_drawer_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_task"
                android:tint="@color/text_secondary"/>

            <TextView
                style="@style/TextAppearance.Whale.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="任务台"/>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/text_tertiary"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPrompt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_drawer_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_edit"
                android:tint="@color/text_secondary"/>

            <TextView
                style="@style/TextAppearance.Whale.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="提示词"/>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/text_tertiary"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_drawer_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/text_secondary"/>

            <TextView
                style="@style/TextAppearance.Whale.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="设置"/>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/text_tertiary"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_drawer_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_info"
                android:tint="@color/text_secondary"/>

            <TextView
                style="@style/TextAppearance.Whale.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="关于"/>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/text_tertiary"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDrawerFooter"
            style="@style/TextAppearance.Whale.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="10dp"
            android:paddingBottom="4dp"
            android:text="v2.0 · AI 可能出错"/>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
