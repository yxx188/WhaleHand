<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle"/>

    <!-- 闪电 / 强度名 / 重置 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="start|center_vertical"
            android:src="@drawable/ic_bolt"
            android:tint="@color/accent_3"/>

        <TextView
            android:id="@+id/tvEffortName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="标准"
            android:textColor="@color/accent"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/btnEffortReset"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/btn_icon"
            android:contentDescription="恢复默认"
            android:padding="8dp"
            android:src="@drawable/ic_reset"
            android:tint="@color/text_secondary"/>
    </FrameLayout>

    <!-- 当前模型 -->
    <LinearLayout
        android:id="@+id/btnPickModel"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tvEffortModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="deepseek-flash"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"/>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_tertiary"/>
    </LinearLayout>

    <SeekBar
        android:id="@+id/sbEffort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:max="4"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:progress="1"
        android:progressDrawable="@drawable/seekbar_progress"
        android:splitTrack="false"
        android:thumb="@drawable/seekbar_thumb"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/tvEffort0" style="@style/TextAppearance.Whale.Caption"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="轻度"/>
        <TextView android:id="@+id/tvEffort1" style="@style/TextAppearance.Whale.Caption"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="标准"/>
        <TextView android:id="@+id/tvEffort2" style="@style/TextAppearance.Whale.Caption"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="深度"/>
        <TextView android:id="@+id/tvEffort3" style="@style/TextAppearance.Whale.Caption"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="pro"/>
        <TextView android:id="@+id/tvEffort4" style="@style/TextAppearance.Whale.Caption"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="ultra"/>
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.Whale.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="思考强度只作用于聊天；换模型后沿用该模型上次的档位"/>
</LinearLayout>
